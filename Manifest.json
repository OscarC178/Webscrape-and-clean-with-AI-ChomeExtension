{
  "manifest_version": 3,
  "name": "RAG Text Scraper",
  "version": "1.0",
  "description": "Extracts clean article text from a list of URLs and saves as .txt files.",
  "permissions": [
    "scripting",
    "downloads",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "Readability.js",
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}

